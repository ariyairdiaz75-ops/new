# Copia este archivo a ".env" y llena tus datos reales.
# NUNCA subas el archivo ".env" a git ni lo compartas con nadie.

# true = Binance Futures Testnet (dinero falso, para probar)
# false = Binance Futures real (dinero real)
BINANCE_TESTNET=true

# ---- Cuenta principal ----
MAIN_LABEL=Principal
MAIN_API_KEY=tu_api_key_cuenta_principal
MAIN_API_SECRET=tu_api_secret_cuenta_principal

# ---- Sub-cuenta ----
# La sub-cuenta de Binance necesita su PROPIA API key de Futuros,
# se crea desde: Binance > Sub-cuentas > (tu sub-cuenta) > Administrar API
SUB_LABEL=Subcuenta
SUB_API_KEY=tu_api_key_subcuenta
SUB_API_SECRET=tu_api_secret_subcuenta

# Servidor local
HOST=127.0.0.1
PORT=8000
