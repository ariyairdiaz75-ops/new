# Copia este archivo a ".env" y llena tus datos reales.
# NUNCA subas el archivo ".env" a git ni lo compartas con nadie.

# true = Binance Futures Testnet (dinero falso, para probar)
# false = Binance Futures real (dinero real)
BINANCE_TESTNET=true

# ---- Cuenta A (la tuya) ----
MAIN_LABEL=Yo
MAIN_API_KEY=tu_api_key
MAIN_API_SECRET=tu_api_secret

# ---- Cuenta B (puede ser tu sub-cuenta O la cuenta de otra persona,
# por ejemplo un amigo) ----
# No tiene que ser una sub-cuenta de Binance: sirve CUALQUIER cuenta de
# Binance con Futuros habilitado y su propia API key. Si es la cuenta de
# otra persona, esa persona debe generar SU PROPIA API key desde SU
# PROPIA cuenta (nunca compartir usuario/contraseña de Binance), con
# Futuros habilitado y SIN permiso de retiros.
SUB_LABEL=Nombre del amigo
SUB_API_KEY=api_key_de_la_segunda_cuenta
SUB_API_SECRET=api_secret_de_la_segunda_cuenta

# Token propio para proteger el panel cuando el servidor está público en
# internet (Railway). Invéntate algo largo y random. Sin esto, CUALQUIERA
# que tenga la URL de tu servidor podría abrir/cerrar órdenes.
DASHBOARD_TOKEN=pon-aqui-algo-largo-y-dificil-de-adivinar

# Servidor local (Railway pone PORT automáticamente, no hace falta tocarlo ahí)
HOST=127.0.0.1
PORT=8000
